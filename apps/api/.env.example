# ---- Obrigatórias ----
NODE_ENV=development
PORT=8110
DATABASE_URL=postgresql://leadhunter:leadhunter_dev@localhost:55433/leadhunter
# Origem(ns) do frontend, separadas por vírgula
CORS_ORIGINS=http://localhost:5210
APP_URL=http://localhost:5210
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-de-48-bytes-ou-mais-aaaaaaaa
# Chave de 32 bytes em base64 para criptografar credenciais de integrações (AES-256-GCM)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ---- Etapa 2+ (filas) ----
REDIS_URL=redis://localhost:6380

# ---- Email (recuperação de senha). Sem SMTP, em dev o link aparece no log da API ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LeadHunter Pro <no-reply@seudominio.com>"
